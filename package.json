{
  "name": "acucar-doce-api",
  "version": "1.0.0",
  "description": "AcucarDoceAPI - IoT device management with Azure Functions",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "dev": "npm run build && func start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@prisma/client": "^6.9.0",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "azure-functions-core-tools": "^4.x",
    "prisma": "^6.9.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20 <23"
  }
}